    "Tap + and enter the name, dates and medications. The tour continues once it's saved." : {
      "comment" : "First-run tour or a one-time tip.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf + und gib Name, Zeitraum und Medikamente ein. Nach dem Speichern geht die Tour weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca + e indica el nombre, las fechas y los medicamentos. El recorrido continuará al guardarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez + et indiquez le nom, les dates et les médicaments. La visite reprend une fois enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca + e inserisci nome, date e farmaci. Il tour prosegue dopo il salvataggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "＋をタップして、名前・期間・薬を入力してください。保存するとツアーが続きます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+ түймесін басып, атауын, күндерін және дәрілерін енгізіңіз. Сақтағаннан кейін тур жалғасады."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atingeți + și introduceți numele, datele și medicamentele. Turul continuă după salvare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите + и укажите название, даты и лекарства. Тур продолжится, когда курс будет сохранён."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть + і вкажіть назву, дати й ліки. Тур продовжиться, щойно курс буде збережено."
          }
        }
      }
    },
