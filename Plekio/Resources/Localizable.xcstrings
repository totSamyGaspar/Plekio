    "A new course with the same medications will be added to Active. The finished one stays in History." : {
      "comment" : "An explanation shown under the date pickers when repeating a course.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neuer Kurs mit denselben Medikamenten wird zu „Aktiv“ hinzugefügt. Der abgeschlossene bleibt im Verlauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se añadirá a Activos un nuevo tratamiento con los mismos medicamentos. El finalizado permanece en el Historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nouveau traitement avec les mêmes médicaments sera ajouté aux traitements en cours. Celui qui est terminé reste dans l’historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nuova terapia con gli stessi farmaci verrà aggiunta ad Attive. Quella conclusa resta nella Cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ薬で新しいコースが「実施中」に追加されます。完了したコースは履歴に残ります。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дәл сол дәрілері бар жаңа курс «Белсенді» тізіміне қосылады. Аяқталған курс тарихта қалады."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tratament nou cu aceleași medicamente va fi adăugat la Active. Cel încheiat rămâne în Istoric."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новый курс с теми же лекарствами появится в «Активных». Завершённый останется в истории."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новий курс із тими самими ліками з’явиться в «Активних». Завершений залишиться в історії."
          }
        }
      }
    },
    "A value outside its range can't be saved. Pulse is optional — leave it empty if your monitor doesn't show one." : {
      "comment" : "An explanation under the blood pressure fields.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wert außerhalb seines Bereichs kann nicht gespeichert werden. Der Puls ist optional — lass das Feld leer, wenn dein Messgerät keinen anzeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un valor fuera de su rango no se puede guardar. El pulso es opcional: déjalo vacío si tu tensiómetro no lo muestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une valeur hors de sa plage ne peut pas être enregistrée. Le pouls est facultatif : laissez le champ vide si votre tensiomètre ne l’affiche pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un valore fuori dal suo intervallo non può essere salvato. Il polso è facoltativo: lascialo vuoto se il misuratore non lo mostra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "範囲外の値は保存できません。脈拍は任意です — 測定器に表示されない場合は空のままにしてください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ауқымнан тыс мән сақталмайды. Тамыр соғысы міндетті емес — тонометр оны көрсетпесе, өрісті бос қалдырыңыз."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O valoare din afara intervalului nu poate fi salvată. Pulsul este opțional — lasă câmpul gol dacă tensiometrul nu îl afișează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значение вне диапазона сохранить нельзя. Пульс необязателен — оставьте поле пустым, если тонометр его не показывает."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значення поза діапазоном зберегти не можна. Пульс необов’язковий — залиште поле порожнім, якщо тонометр його не показує."
          }
        }
      }
    },
