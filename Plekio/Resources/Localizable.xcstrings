    "Track how your body responds to your regimen, log symptoms, record daily energy levels, and compare progress photos over time." : {
      "comment" : "A description of the features of the daily health and mood diary.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolge, wie dein Körper auf die Therapie reagiert, halte Symptome und Energie fest und vergleiche Fortschrittsfotos über die Zeit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue cómo responde tu cuerpo al tratamiento, registra síntomas y niveles de energía y compara fotos de progreso a lo largo del tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez la réaction de votre corps au traitement, consignez symptômes et énergie, et comparez vos photos de progrès dans le temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitora come il tuo corpo risponde alla terapia, registra i sintomi e i livelli di energia quotidiani e confronta le foto dei progressi nel tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体が治療にどう反応しているかを記録し、症状や日々のエネルギーを残して、経過写真を比較しましょう。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ағзаңыздың емге қалай жауап беретінін бақылаңыз, белгілерді белгілеңіз, күнделікті қуат деңгейін жазып, прогресс суреттерін салыстырыңыз."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urmărește cum răspunde corpul la tratament, notează simptomele și nivelul de energie și compară fotografiile de progres în timp."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следите за тем, как организм отвечает на курс, отмечайте симптомы и уровень энергии, сравнивайте фото прогресса."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стежте за тим, як організм відповідає на курс, занотовуйте симптоми та рівень енергії, порівнюйте фото прогресу."
          }
        }
      }
    },
