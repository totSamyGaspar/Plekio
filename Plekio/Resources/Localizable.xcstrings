    "Hold the reminder to take a dose, snooze it or skip it — what is left in the pack goes down by itself." : {
      "comment" : "Body of the third onboarding slide.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Erinnerung gedrückt, um eine Dosis einzunehmen, zu verschieben oder auszulassen – der Packungsbestand sinkt von allein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el recordatorio para tomar, posponer u omitir una dosis, y las unidades del envase bajan solas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le rappel appuyé pour prendre, reporter ou sauter une prise : le stock de la boîte diminue tout seul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto il promemoria per prendere, rimandare o saltare una dose: la scorta nella confezione cala da sé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知を長押しして、服用・後で・スキップを選ぶだけ。残りの錠数も自動で減ります。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозаны қабылдау, кейінге қалдыру не өткізіп жіберу үшін еске салуды басып тұрыңыз — қораптағы қалдық өзі азаяды."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ține apăsat pe memento ca să iei, să amâni sau să sari o doză, iar stocul din cutie scade singur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте напоминание, чтобы принять, отложить или пропустить дозу, — запас в упаковке уменьшится сам."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утримуйте нагадування, щоб прийняти, відкласти чи пропустити дозу, — запас в упаковці зменшиться сам."
          }
        }
      }
    },
