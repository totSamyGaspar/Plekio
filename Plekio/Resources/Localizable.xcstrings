        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қазір өзіңізді қалай сезінесіз? Жылдам белгілеу үшін көңіл-күйді түртіңіз немесе толық жазба мен сурет қосыңыз."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cum te simți acum? Atinge o dispoziție pentru o notare rapidă sau completează note și fotografii detaliate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
