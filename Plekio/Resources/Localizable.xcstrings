    "Morning, afternoon and evening apart. One tap logs a dose, another takes it back." : {
      "comment" : "Body of the second onboarding slide.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgen, Mittag und Abend getrennt. Ein Tippen bucht eine Dosis, noch eins nimmt sie zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mañana, tarde y noche por separado. Un toque registra una dosis, otro la deshace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matin, après-midi et soir séparément. Un appui enregistre une prise, un autre l'annule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mattina, pomeriggio e sera separati. Un tocco registra una dose, un altro la annulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朝・昼・夜は別々に。タップで服用を記録、もう一度タップで取り消し。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таң, күндіз және кеш бөлек. Бір рет түрту — доза белгіленді, тағы бірі — күші жойылды."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimineața, după-amiaza și seara separat. O atingere înregistrează o doză, alta o anulează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утро, день и вечер отдельно. Одно касание — доза отмечена, ещё одно — отменено."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ранок, день і вечір окремо. Один дотик — доза відмічена, ще один — скасовано."
          }
        }
      }
    },
