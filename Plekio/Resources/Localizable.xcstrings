    "How are you feeling right now? Tap a mood to log quickly or fill in detailed notes & photos." : {
      "comment" : "A description of how to fill out a diary entry.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie fühlst du dich gerade? Tippe auf eine Stimmung für einen schnellen Eintrag oder erfasse ausführliche Notizen und Fotos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cómo te sientes ahora? Toca un estado de ánimo para registrarlo rápido o añade notas y fotos detalladas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment vous sentez-vous ? Touchez une humeur pour un enregistrement rapide, ou ajoutez notes et photos détaillées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come ti senti adesso? Tocca un umore per registrarlo subito oppure aggiungi note e foto dettagliate."
          }
        },
        "ja" : {
          "stringUnit" : {
