    "A report for your doctor" : {
      "comment" : "First-run tour or a one-time tip.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Bericht für deinen Arzt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un informe para tu médico"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rapport pour votre médecin"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un referto per il tuo medico"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "医師向けのレポート"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дәрігерге арналған есеп"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un raport pentru medicul dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отчёт для врача"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звіт для лікаря"
          }
        }
      }
    },
    "Add photos to your entries, then tick two in the gallery to see them side by side." : {
      "comment" : "First-run tour or a one-time tip.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge deinen Einträgen Fotos hinzu und markiere dann zwei in der Galerie, um sie nebeneinander zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade fotos a tus entradas y marca dos en la galería para verlas una junto a otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des photos à vos entrées, puis cochez-en deux dans la galerie pour les voir côte à côte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi foto alle voci, poi selezionane due nella galleria per vederle affiancate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録に写真を追加し、ギャラリーで2枚選ぶと並べて比較できます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жазбаларға фото қосып, қатар көру үшін галереядан екеуін белгілеңіз."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adăugați fotografii la înregistrări, apoi bifați două în galerie pentru a le vedea alăturat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляйте фото к записям, а затем отметьте два в галерее, чтобы увидеть их рядом."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додавайте фото до записів, а потім позначте два в галереї, щоб побачити їх поруч."
          }
        }
      }
    },
    "Build a PDF with doses, well-being and blood pressure for any period." : {
      "comment" : "First-run tour or a one-time tip.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle ein PDF mit Dosen, Befinden und Blutdruck für einen beliebigen Zeitraum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un PDF con dosis, bienestar y presión arterial de cualquier periodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez un PDF avec les prises, le bien-être et la tension sur la période de votre choix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un PDF con dosi, benessere e pressione per qualsiasi periodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意の期間の服用・体調・血圧をまとめたPDFを作成できます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кез келген кезеңге дозалар, көңіл күй және қан қысымы бар PDF жасаңыз."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creați un PDF cu dozele, starea și tensiunea pentru orice perioadă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соберите PDF с дозами, самочувствием и давлением за любой период."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберіть PDF із дозами, самопочуттям і тиском за будь-який період."
          }
        }
      }
    },
