    "Reports you share later will carry these details. You can change them any time in Settings." : {
      "comment" : "An explanation under the title of the profile step of onboarding.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Später geteilte Berichte enthalten diese Angaben. Sie lassen sich jederzeit in den Einstellungen ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los informes que compartas incluirán estos datos. Puedes cambiarlos cuando quieras en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rapports que vous partagerez contiendront ces informations. Vous pouvez les modifier à tout moment dans les réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I referti che condividerai riporteranno questi dati. Puoi modificarli quando vuoi nelle impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有するレポートにこの情報が記載されます。設定でいつでも変更できます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кейін бөлісетін есептерде осы деректер болады. Оларды баптауларда кез келген уақытта өзгертуге болады."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapoartele pe care le vei partaja vor conține aceste date. Le poți schimba oricând în setări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти данные попадут в отчёты, которыми вы поделитесь. Изменить их можно в любой момент в настройках."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ці дані потраплять у звіти, якими ви поділитеся. Змінити їх можна будь-коли в налаштуваннях."
          }
        }
      }
    },
