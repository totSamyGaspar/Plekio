    "Open History and tap Repeat to start the same treatment again with new dates." : {
      "comment" : "First-run tour or a one-time tip.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne den Verlauf und tippe auf Wiederholen, um dieselbe Behandlung mit neuen Daten zu starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Historial y toca Repetir para empezar el mismo tratamiento con nuevas fechas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez l'Historique et touchez Répéter pour relancer le même traitement à de nouvelles dates."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri la Cronologia e tocca Ripeti per riprendere la stessa terapia con nuove date."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴を開いて「繰り返す」をタップすると、同じコースを新しい日程で始められます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тарихты ашып, дәл сол емді жаңа күндермен бастау үшін «Қайталау» түймесін басыңыз."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deschideți Istoricul și atingeți Repetă pentru a relua același tratament cu date noi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте Историю и нажмите «Повторить», чтобы начать тот же курс с новыми датами."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрийте Історію й натисніть «Повторити», щоб почати той самий курс із новими датами."
          }
        }
      }
    },
