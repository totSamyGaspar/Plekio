    "Entries: %lld, photos: %lld. Blood pressure readings are kept. This can't be undone." : {
      "comment" : "Settings > Storage: deleting every diary entry.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einträge: %1$lld, Fotos: %2$lld. Blutdruckwerte bleiben erhalten. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entradas: %1$lld, fotos: %2$lld. Las mediciones de presión se conservan. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrées : %1$lld, photos : %2$lld. Les mesures de tension sont conservées. Action irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voci: %1$lld, foto: %2$lld. Le misurazioni della pressione restano. L'azione è irreversibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録：%1$lld件、写真：%2$lld枚。血圧の記録は残ります。この操作は取り消せません。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жазбалар: %1$lld, фотолар: %2$lld. Қан қысымы өлшемдері сақталады. Бұл әрекетті қайтару мүмкін емес."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înregistrări: %1$lld, fotografii: %2$lld. Măsurătorile tensiunii se păstrează. Acțiunea nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записей: %1$lld, фото: %2$lld. Измерения давления сохранятся. Это действие нельзя отменить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записів: %1$lld, фото: %2$lld. Вимірювання тиску збережуться. Цю дію не можна скасувати."
          }
        }
      }
    },
