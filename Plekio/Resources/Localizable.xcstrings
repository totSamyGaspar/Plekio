    "Storage on this device is unavailable. The app is running in temporary mode — entries will not survive a restart." : {
      "comment" : "Message shown to the user when the app can't access the storage on the device.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Speicher auf diesem Gerät ist nicht verfügbar. Die App läuft im temporären Modus – Einträge überstehen keinen Neustart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El almacenamiento de este dispositivo no está disponible. La app funciona en modo temporal: las entradas no sobrevivirán a un reinicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le stockage de cet appareil est indisponible. L'app fonctionne en mode temporaire : les entrées ne survivront pas à un redémarrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'archiviazione su questo dispositivo non è disponibile. L'app è in modalità temporanea: le voci non sopravvivranno a un riavvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末のストレージを利用できません。アプリは一時モードで動作しており、記録は再起動後に残りません。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл құрылғыдағы жад қолжетімсіз. Қолданба уақытша режимде жұмыс істеп тұр — жазбалар қайта қосқаннан кейін сақталмайды."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stocarea pe acest dispozitiv nu este disponibilă. Aplicația rulează în mod temporar — intrările nu vor supraviețui unei reporniri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранилище на устройстве недоступно. Приложение работает во временном режиме — записи не сохранятся после перезапуска."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сховище на пристрої недоступне. Застосунок працює у тимчасовому режимі — записи не збережуться після перезапуску."
          }
        }
      }
    },
