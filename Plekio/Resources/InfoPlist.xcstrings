        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plekio uses your photo library so you can attach a photo of your medication."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plekio usa tu fototeca para que puedas adjuntar una foto de tu medicamento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plekio utilise votre photothèque pour vous permettre d’ajouter une photo de votre médicament."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plekio usa la libreria foto per consentirti di allegare una foto del tuo farmaco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薬の写真を添付できるように、Plekioは写真ライブラリを使用します。"
