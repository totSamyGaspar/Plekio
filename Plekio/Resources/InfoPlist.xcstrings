    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plekio verwendet die Kamera, damit du ein Foto deines Medikaments hinzufügen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plekio uses the camera so you can attach a photo of your medication."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plekio usa la cámara para que puedas adjuntar una foto de tu medicamento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plekio utilise l’appareil photo pour vous permettre d’ajouter une photo de votre médicament."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plekio usa la fotocamera per consentirti di allegare una foto del tuo farmaco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薬の写真を添付できるように、Plekioはカメラを使用します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дәріңіздің фотосуретін тіркей алуыңыз үшін Plekio камераны пайдаланады."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plekio folosește camera pentru a putea atașa o fotografie a medicamentului tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plekio использует камеру, чтобы вы могли прикрепить фотографию лекарства."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plekio використовує камеру, щоб ви могли додати фотографію ліків."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende Face ID, um Plekio zu entsperren und deine Gesundheitsdaten zu schützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Face ID to unlock Plekio and protect access to your health data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Face ID para desbloquear Plekio y proteger tus datos de salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Face ID pour déverrouiller Plekio et protéger vos données de santé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Face ID per sbloccare Plekio e proteggere i tuoi dati sanitari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face IDでPlekioのロックを解除し、健康データへのアクセスを保護します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plekio құлпын ашу және денсаулық деректерін қорғау үшін Face ID пайдаланыңыз."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosește Face ID pentru a debloca Plekio și a proteja datele tale de sănătate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте Face ID для разблокировки Plekio и защиты доступа к данным о здоровье."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте Face ID для розблокування Plekio та захисту доступу до даних про здоров’я."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plekio verwendet deine Fotomediathek, damit du ein Foto deines Medikaments hinzufügen kannst."
